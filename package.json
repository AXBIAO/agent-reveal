{
  "name": "agent-reveal",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Turn any finished web page into a \"swarm of AI agents building it\" demo — multi-cursor marquee selection, human-like typing, and clean MP4 tab recording. Chrome extension + bookmarklet.",
  "keywords": ["chrome-extension", "bookmarklet", "demo", "screen-recording", "animation", "multi-cursor", "webcodecs"],
  "license": "MIT",
  "author": "AXBIAO",
  "homepage": "https://github.com/AXBIAO/agent-reveal#readme",
  "repository": { "type": "git", "url": "git+https://github.com/AXBIAO/agent-reveal.git" },
  "bugs": { "url": "https://github.com/AXBIAO/agent-reveal/issues" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit && node tests/av-sync.e2e.mjs && node scripts/build.mjs && node tests/e2e.mjs && node tests/extension.e2e.mjs",
    "test:sync": "node tests/av-sync.e2e.mjs",
    "test:unit": "node --test tests/typing.test.mjs tests/extension.test.mjs tests/visual.test.mjs",
    "test:e2e": "node scripts/build.mjs && node tests/e2e.mjs",
    "test:ext": "node scripts/build.mjs && node tests/extension.e2e.mjs",
    "record": "node scripts/build.mjs && node tests/e2e.mjs --record",
    "docs:shots": "node scripts/docs-shots.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "mp4-muxer": "^5.2.2",
    "playwright": "^1.56.0"
  }
}
